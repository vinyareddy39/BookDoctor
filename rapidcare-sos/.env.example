# Backend API Base URL (Required for real phone testing!)
# NEVER use localhost on a physical phone (localhost refers to the phone itself).
# Option A (Same Wi-Fi): http://<YOUR_PC_LAN_IP>:5000 (e.g. http://192.168.1.15:5000)
# Option B (Any network / cellular): https://<your-id>.ngrok-free.app
EXPO_PUBLIC_API_URL=http://192.168.1.15:5000

# Google Places API Key (Optional: if omitted, free OpenStreetMap Overpass API is used)
EXPO_PUBLIC_PLACES_API_KEY=

# Configurable SMS Templates (Optional overrides; supports {{MAPS_LINK}} and {{HOSPITAL_NAME}})
# For India (+91) live SMS via Twilio/MSG91, templates must match your TRAI DLT registration.
EXPO_PUBLIC_SMS_TEMPLATE_LOCATION=SOS - I need help. My location: {{MAPS_LINK}}
EXPO_PUBLIC_SMS_TEMPLATE_HOSPITAL=Nearest emergency hospital: {{HOSPITAL_NAME}}
EXPO_PUBLIC_SMS_TEMPLATE_WATCHDOG=Ride could not be confirmed. Please call me or send help.
EXPO_PUBLIC_SMS_TEMPLATE_NO_LOCATION=SOS - location unavailable, please call me
