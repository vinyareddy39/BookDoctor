# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

# SMS Provider Configuration (TWILIO or MSG91)
# Leave blank to use local DevConsole logger in development
SMS_PROVIDER=TWILIO

# Twilio SMS Credentials (use Twilio Test Credentials or Verified Numbers for dev/sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Configurable SMS Templates (Supports {{MAPS_LINK}} and {{HOSPITAL_NAME}})
# Note: For production SMS in India (+91), templates and Sender IDs MUST be DLT-registered with TRAI/operators.
SMS_TEMPLATE_LOCATION=SOS - I need help. My location: {{MAPS_LINK}}
SMS_TEMPLATE_HOSPITAL=Nearest emergency hospital: {{HOSPITAL_NAME}}
SMS_TEMPLATE_WATCHDOG=Ride could not be confirmed. Please call me or send help.

# Outbound Voice Emergency Call (Twilio Voice)
# Disabled by default for safety; set to "true" only when live Twilio voice bridging is authorized.
ENABLE_OUTBOUND_EMERGENCY_CALL=false
EMERGENCY_PHONE_NUMBER=
BUSINESS_PHONE_NUMBER=
PUBLIC_SERVER_URL=

# MSG91 SMS Credentials (for DLT-compliant India routes)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RAPIDC
MSG91_TEMPLATE_ID=

# Razorpay Payment Gateway (Test / Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_TEST_KEYS=false

# Client URL (CORS & OAuth Redirects)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

# Google Calendar OAuth 2.0 Integration (for Doctor Availability Sync)
# 1. Enable 'Google Calendar API' in Google Cloud Console
# 2. Add 'http://localhost:5000/api/google/callback' to Authorized redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Uber API & Riders OAuth 2.0 Integration
# UBER_ENV=sandbox (uses https://sandbox-api.uber.com/v1.2) | production (uses https://api.uber.com/v1.2)
UBER_ENV=sandbox
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# IMPORTANT: This exact URI MUST also be saved in Uber Developer Dashboard -> Setup -> Redirect URIs
UBER_REDIRECT_URI=http://localhost:5000/api/uber/callback
UBER_RIDE_PROVIDER=uber_api
ENCRYPTION_SECRET=bookdoctor_aes256_emergency_secret_key_32_bytes!

# OpenStreetMap & OSRM Routing Engines
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
