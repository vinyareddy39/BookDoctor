# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

# Razorpay Payment Gateway (Test / Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: Set to true if running in staging environment with test keys (rzp_test_...)
RAZORPAY_ALLOW_TEST_KEYS=false

# Demo Mode toggle (optional, development only)
DEMO_MODE=false

# Client URL (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Twilio (Emergency Dispatch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EMERGENCY_PHONE_NUMBER=

# SOS Emergency & Uber Integration
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_REDIRECT_URI=http://localhost:5000/api/uber/oauth/callback
UBER_SANDBOX=true
UBER_RIDE_PROVIDER=uber_api
ENCRYPTION_SECRET=bookdoctor_aes256_emergency_secret_key_32_bytes!

# OpenStreetMap & OSRM Routing Engines
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
